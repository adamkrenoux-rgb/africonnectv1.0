// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TRAVELER
  BUSINESS
  INFLUENCER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessType {
  SAFARI
  ADVENTURE
  CULTURAL
  LUXURY
  BUDGET
  ACCOMMODATION
  TRANSPORT
  FOOD
  OTHER
}

enum ActivityType {
  WILDLIFE_SAFARI
  MOUNTAIN_CLIMBING
  CULTURAL_TOUR
  BEACH_ACTIVITY
  CITY_TOUR
  ADVENTURE_SPORT
  CULINARY_EXPERIENCE
  PHOTOGRAPHY_TOUR
  VOLUNTEER_WORK
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  HELD_IN_ESCROW
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CampaignStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum CollaborationType {
  SPONSORED_POST
  PRODUCT_REVIEW
  EXPERIENCE_SHARE
  BRAND_AMBASSADOR
  OTHER
}

enum DocumentType {
  BUSINESS_LICENSE
  GOVERNMENT_ID
  TAX_CERTIFICATE
  INSURANCE_CERTIFICATE
  OTHER
}

enum TravelerType {
  EXPAT
  DIPLOMAT
  TOURIST
  LOCAL
  OTHER
}

enum NotificationType {
  OFFER
  NEW_TRIP
  SAFETY_ALERT
  MESSAGE
  RECOMMENDATION
  GENERAL
}

enum ContentFeedType {
  EXPERIENCE
  NEWS
  SAFETY_TIP
  EVENT
  OPPORTUNITY
}

enum RecommendationSource {
  AI
  TRENDING
  HISTORY
  PARTNER
}

enum RemotenessLevel {
  URBAN
  SUBURBAN
  RURAL
  REMOTE
  EXTREME
}

enum EntityType {
  BUSINESS
  LISTING
  CAMPAIGN
  ITINERARY
  OTHER
}

enum WalletTransactionType {
  DEPOSIT
  HOLD
  RELEASE
  REFUND
  WITHDRAWAL
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  POSTED
  FAILED
}

enum DisputeTargetType {
  BOOKING
  CAMPAIGN
  APPLICATION
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CANCELLED
}

enum PlanTier {
  FREE
  BASIC
  PRO
  DIAMOND
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE_EXPIRED
  UNPAID
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

model User {
  id                 String             @id @default(cuid())
  clerkId            String             @unique
  email              String             @unique
  name               String?
  role               UserRole           @default(TRAVELER)
  profilePicture     String?
  bio                String?
  socialLinks        Json?
  isVerified         Boolean            @default(false)
  country            String?
  verificationStatus VerificationStatus @default(PENDING)
  primaryLanguage    String?
  preferredLocales   String[]           @default([])
  lastActiveAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  businesses       Business[]
  bookings         Booking[]
  campaigns        Campaign[]
  reviews          Review[]
  sentMessages     Message[]        @relation("MessageSender")
  receivedMessages Message[]        @relation("MessageReceiver")
  travelerProfile  TravelerProfile?
  notifications    Notification[]
  favorites        Favorite[]
  walletAccount    WalletAccount?
  disputesFiled    Dispute[]           @relation("DisputeByUser")
  disputesAgainst  Dispute[]           @relation("DisputeAgainstUser")
  disputeMessages  DisputeMessage[]
  subscriptions    Subscription[]
  promotions       Promotion[]
  apiKeys          ApiKey[]
  loyaltyAccount   LoyaltyAccount?
  influencerPortfolio InfluencerPortfolio?

  @@map("users")
}

model Business {
  id                   String        @id @default(cuid())
  userId               String
  businessName         String
  description          String
  location             String
  city                 String
  country              String
  coordinates          Json? // [latitude, longitude]
  businessType         BusinessType
  verificationBadge    Boolean       @default(false)
  trustScore           Float         @default(0.0)
  website              String?
  phone                String?
  email                String?
  identityDocumentType DocumentType?
  identityDocumentUrl  String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relations
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings               Listing[]
  bookings               Booking[]
  applications           Application[]
  reviews                Review[]
  verifications          Verification[]
  culturalExperiences    CulturalExperience[]
  SafetyProfile          SafetyProfile?
  TravelerRecommendation TravelerRecommendation[]
  promotions             Promotion[]

  @@map("businesses")
}

model Listing {
  id                 String       @id @default(cuid())
  businessId         String
  title              String
  description        String
  pricing            Json // { basePrice: number, currency: string, pricingType: string }
  duration           String
  activityType       ActivityType
  tags               String[]
  verified           Boolean      @default(false)
  maxCapacity        Int          @default(1)
  availability       Json? // { startDate: string, endDate: string }
  culturalHighlights Json?
  experienceStyle    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  recommendations    TravelerRecommendation[]
  feedItems          TravelerFeedItem[]
  SafetyProfile      SafetyProfile?
  CulturalExperience CulturalExperience[]
  promotions         Promotion[]

  @@map("listings")
}

model Booking {
  id                    String        @id @default(cuid())
  listingId             String
  travelerId            String
  businessId            String
  bookingDate           DateTime
  totalAmount           Float
  commission            Float
  paymentStatus         PaymentStatus @default(PENDING)
  status                BookingStatus @default(PENDING)
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  listing             Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  traveler            User                  @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  review              Review?
  TravelerTripHistory TravelerTripHistory[]

  @@map("bookings")
}

model Campaign {
  id                   String         @id @default(cuid())
  influencerId         String
  title                String
  description          String
  targetRegion         String[]
  deliverables         Json // { posts: number, reels: number, stories: number }
  audienceDemographics Json // { ageRange: [number, number], interests: string[], location: string[] }
  collaborationTerms   String?
  status               CampaignStatus @default(DRAFT)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Relations
  influencer   User          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("campaigns")
}

model Application {
  id             String            @id @default(cuid())
  campaignId     String
  businessId     String
  proposalText   String
  contentSamples Json? // { images: string[], videos: string[] }
  aiInsights     Json? // AI-generated insights about the application
  status         ApplicationStatus @default(PENDING)
  proposedPrice  Float?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("applications")
}

model Review {
  id                   String        @id @default(cuid())
  bookingId            String        @unique
  travelerId           String
  businessId           String
  rating               Int // 1-5 stars
  comment              String?
  response             String? // Business response to review
  travelerType         TravelerType?
  isVerifiedReviewer   Boolean       @default(false)
  verificationEvidence Json?
  language             String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relations
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  traveler User     @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Verification {
  id                 String             @id @default(cuid())
  businessId         String
  documentType       DocumentType
  documentUrl        String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("verifications")
}

model AIAnalysis {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  inputData  Json // Input data for AI analysis
  outputData Json // AI-generated output
  modelUsed  String // OpenAI model used
  createdAt  DateTime   @default(now())

  @@map("ai_analyses")
}

model Message {
  id             String   @id @default(cuid())
  senderId       String
  receiverId     String
  content        String
  read           Boolean  @default(false)
  language       String?
  translatedFrom String?
  createdAt      DateTime @default(now())

  // Relations
  sender       User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User                 @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  translations MessageTranslation[]

  @@map("messages")
}

model TravelerProfile {
  id                       String        @id @default(cuid())
  userId                   String        @unique
  travelerType             TravelerType?
  homeBase                 String?
  preferredBudgetRange     Json?
  preferredActivities      String[]      @default([])
  preferredLanguages       String[]      @default([])
  mobilityNeeds            String?
  accessibilityNotes       String?
  aiSetupCompleted         Boolean       @default(false)
  introSummary             String?
  identityVerified         Boolean       @default(false)
  verificationDocumentUrl  String?
  verificationDocumentType DocumentType?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences     TravelerPreference?
  tripPlans       TripPlan[]
  recommendations TravelerRecommendation[]
  chatSessions    TravelerChatSession[]
  notifications   Notification[]
  tripHistory     TravelerTripHistory[]

  @@map("traveler_profiles")
}

model TravelerPreference {
  id                        String   @id @default(cuid())
  travelerProfileId         String   @unique
  budgetMin                 Int?
  budgetMax                 Int?
  preferredDistanceKm       Int?
  travelPace                String?
  dietaryNeeds              String?
  riskTolerance             String?
  accommodationPreferences  String?
  transportationPreferences String?
  priorities                Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  travelerProfile TravelerProfile @relation(fields: [travelerProfileId], references: [id], onDelete: Cascade)

  @@map("traveler_preferences")
}

model TripPlan {
  id                String    @id @default(cuid())
  travelerProfileId String
  title             String
  startDate         DateTime?
  endDate           DateTime?
  destinations      Json?
  activities        Json?
  lastHealthCheckId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  travelerProfile TravelerProfile          @relation(fields: [travelerProfileId], references: [id], onDelete: Cascade)
  healthChecks    TripHealthCheck[]
  recommendations TravelerRecommendation[]

  @@map("trip_plans")
}

model TripHealthCheck {
  id              String   @id @default(cuid())
  tripPlanId      String
  aiAnalysisId    String?
  issues          Json
  recommendations Json
  status          String?
  createdAt       DateTime @default(now())

  tripPlan TripPlan @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)

  @@map("trip_health_checks")
}

model TravelerTripHistory {
  id                String   @id @default(cuid())
  travelerProfileId String
  bookingId         String?
  summary           String?
  learnings         Json?
  tags              String[] @default([])
  createdAt         DateTime @default(now())

  travelerProfile TravelerProfile @relation(fields: [travelerProfileId], references: [id], onDelete: Cascade)
  booking         Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("traveler_trip_history")
}

model SafetyProfile {
  id                  String           @id @default(cuid())
  businessId          String?
  listingId           String?
  region              String?
  cellCoverage        String?
  emergencyContacts   Json?
  healthAdvisories    Json?
  medicalFacilities   Json?
  transportationNotes String?
  remotenessLevel     RemotenessLevel?
  updatedBy           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([businessId], map: "safety_profile_business_unique")
  @@unique([listingId], map: "safety_profile_listing_unique")
  @@map("safety_profiles")
}

model CulturalExperience {
  id             String   @id @default(cuid())
  businessId     String?
  listingId      String?
  title          String
  description    String
  region         String
  tags           String[]
  media          Json?
  recommendedFor String?
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business        Business?                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listing         Listing?                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  recommendations TravelerRecommendation[]
  feedItems       TravelerFeedItem[]

  @@map("cultural_experiences")
}

model TravelerRecommendation {
  id                   String               @id @default(cuid())
  travelerProfileId    String
  tripPlanId           String?
  listingId            String?
  businessId           String?
  culturalExperienceId String?
  recommendationSource RecommendationSource @default(AI)
  score                Float?
  reason               Json?
  createdAt            DateTime             @default(now())

  travelerProfile    TravelerProfile     @relation(fields: [travelerProfileId], references: [id], onDelete: Cascade)
  tripPlan           TripPlan?           @relation(fields: [tripPlanId], references: [id], onDelete: SetNull)
  listing            Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  business           Business?           @relation(fields: [businessId], references: [id], onDelete: SetNull)
  culturalExperience CulturalExperience? @relation(fields: [culturalExperienceId], references: [id], onDelete: SetNull)

  @@map("traveler_recommendations")
}

model TravelerChatSession {
  id                String   @id @default(cuid())
  travelerProfileId String
  title             String?
  locale            String?
  context           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  travelerProfile TravelerProfile       @relation(fields: [travelerProfileId], references: [id], onDelete: Cascade)
  messages        TravelerChatMessage[]

  @@map("traveler_chat_sessions")
}

model TravelerChatMessage {
  id         String   @id @default(cuid())
  sessionId  String
  senderRole String
  content    String
  metadata   Json?
  createdAt  DateTime @default(now())

  session TravelerChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("traveler_chat_messages")
}

model TravelerFeedItem {
  id                  String          @id @default(cuid())
  region              String
  contentType         ContentFeedType
  title               String
  summary             String?
  body                String?
  media               Json?
  relatedListingId    String?
  relatedExperienceId String?
  priority            Int             @default(0)
  publishAt           DateTime?
  expiresAt           DateTime?
  createdAt           DateTime        @default(now())

  relatedListing    Listing?            @relation(fields: [relatedListingId], references: [id], onDelete: SetNull)
  relatedExperience CulturalExperience? @relation(fields: [relatedExperienceId], references: [id], onDelete: SetNull)

  @@map("traveler_feed_items")
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  travelerProfileId String?
  notificationType  NotificationType
  title             String
  message           String
  data              Json?
  read              Boolean          @default(false)
  readAt            DateTime?
  sentAt            DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelerProfile TravelerProfile? @relation(fields: [travelerProfileId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model MessageTranslation {
  id                String   @id @default(cuid())
  messageId         String
  targetLanguage    String
  translatedContent String
  provider          String?
  createdAt         DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, targetLanguage], map: "message_translation_unique")
  @@map("message_translations")
}

model Favorite {
  id         String     @id @default(cuid())
  userId     String
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId], map: "favorite_unique_per_entity")
  @@map("favorites")
}

model WalletAccount {
  id         String   @id @default(cuid())
  userId     String   @unique
  currency   String   @default("USD")
  available  Float    @default(0)
  pending    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet_accounts")
}

model WalletTransaction {
  id              String                  @id @default(cuid())
  walletAccountId String
  amount          Float
  currency        String                  @default("USD")
  type            WalletTransactionType
  status          WalletTransactionStatus @default(POSTED)
  referenceType   EntityType?
  referenceId     String?
  description     String?
  metadata        Json?
  createdAt       DateTime                @default(now())

  walletAccount WalletAccount @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)

  @@index([walletAccountId, createdAt])
  @@map("wallet_transactions")
}

model Dispute {
  id               String          @id @default(cuid())
  targetType       DisputeTargetType
  targetId         String
  createdByUserId  String
  againstUserId    String?
  reason           String
  details          String?
  status           DisputeStatus   @default(OPEN)
  resolutionNotes  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  createdBy  User     @relation("DisputeByUser", fields: [createdByUserId], references: [id], onDelete: Cascade)
  against    User?    @relation("DisputeAgainstUser", fields: [againstUserId], references: [id], onDelete: SetNull)
  messages   DisputeMessage[]

  @@index([targetType, targetId])
  @@map("disputes")
}

model DisputeMessage {
  id         String   @id @default(cuid())
  disputeId  String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("dispute_messages")
}

model Plan {
  id            String    @id @default(cuid())
  tier          PlanTier  @unique
  name          String
  priceCents    Int       @default(0)
  currency      String    @default("USD")
  stripePriceId String?
  features      String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entitlements PlanEntitlement[]

  @@map("plans")
}

model PlanEntitlement {
  id          String   @id @default(cuid())
  planId      String
  key         String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key], map: "plan_entitlement_unique")
  @@map("plan_entitlements")
}

model Subscription {
  id                  String              @id @default(cuid())
  userId              String
  planTier            PlanTier
  status              SubscriptionStatus  @default(INCOMPLETE)
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean             @default(false)
  stripeCustomerId    String?
  stripeSubscriptionId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

model Promotion {
  id           String          @id @default(cuid())
  userId       String
  businessId   String?
  listingId    String?
  region       String?
  budgetCents  Int             @default(0)
  status       PromotionStatus @default(DRAFT)
  priorityBoost Int            @default(0)
  metrics      Json?
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  listing  Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([status, region])
  @@map("promotions")
}

model ApiKey {
  id                 String       @id @default(cuid())
  userId             String
  name               String
  keyPrefix          String       @unique
  keyHash            String
  status             ApiKeyStatus @default(ACTIVE)
  rateLimitPerMinute Int          @default(60)
  lastUsedAt         DateTime?
  createdAt          DateTime     @default(now())
  revokedAt          DateTime?

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage ApiKeyUsage[]

  @@map("api_keys")
}

model ApiKeyUsage {
  id        String   @id @default(cuid())
  apiKeyId  String
  windowStart DateTime // start of the minute window
  count     Int      @default(0)

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, windowStart], map: "api_key_usage_unique_window")
  @@map("api_key_usage")
}

model InfluencerPortfolio {
  id         String   @id @default(cuid())
  userId     String   @unique
  headline   String?
  bio        String?
  stats      Json? // { followers: { ig: number, yt: number, tiktok: number }, avgEngagement: number, audience: {...} }
  niches     String[] @default([])
  links      Json? // { instagram, youtube, tiktok, website, ... }
  media      Json? // [{ type: 'image'|'video', url, caption }]
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  exportedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("influencer_portfolios")
}

model LoyaltyAccount {
  id         String   @id @default(cuid())
  userId     String   @unique
  points     Int      @default(0)
  tier       String   @default("BRONZE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id              String                @id @default(cuid())
  loyaltyAccountId String
  type            LoyaltyTransactionType
  points          Int
  reason          String?
  referenceType   EntityType?
  referenceId     String?
  metadata        Json?
  createdAt       DateTime              @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([loyaltyAccountId, createdAt])
  @@map("loyalty_transactions")
}
